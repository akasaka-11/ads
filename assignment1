def is_palindrome(s):
    if len(s) <= 1:
        return True
    if s[0] != s[-1]:
        return False
    return is_palindrome(s[1:-1])
print("Palindrome" if is_palindrome("level") else "Not palindrome")  
print("Palindrome" if is_palindrome("hello") else "Not palindrome") 
