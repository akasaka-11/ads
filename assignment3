class TreeNode:
    def __init__(self, value):
        self.value = value
        self.left = None
        self.right = None


# Build tree: [1, None, 3, 2, 4, None, None, None, 5]
def build_tree():
    root = TreeNode(1)
    root.right = TreeNode(3)
    root.right.left = TreeNode(2)
    root.right.right = TreeNode(4)
    root.right.right.right = TreeNode(5)
    return root


def longestConsecutive(root):
    def dfs(node, parent_val, length):
        if not node:
            return length

        # check if consecutive
        if node.value == parent_val + 1:
            length += 1
        else:
            length = 1

        # explore both sides
        return max(
            length,
            dfs(node.left, node.value, length),
            dfs(node.right, node.value, length)
        )

    return dfs(root, float('-inf'), 0)


# Run
root = build_tree()
print(longestConsecutive(root))  
