#task3
def sum_natural(n):
    if n == 0:
        return 0
    return n + sum_natural(n-1)

n = int(input())
print(sum_natural(n))
#task4
def factorial(n):
    if n == 0 or n == 1:
        return 1
    return n * factorial(n-1)

n = int(input())
print(factorial(n))
#task5
def power(a, b):
    if b == 0:
        return 1
    return a * power(a, b-1)

a, b = map(int, input().split())
print(power(a, b))
#task6
def sum_digits(n):
    if n == 0:
        return 0
    return n % 10 + sum_digits(n // 10)

n = int(input())
print(sum_digits(n))
#task7
def count_digits(n):
    if n == 0:
        return 0
    return 1 + count_digits(n // 10)

n = int(input())
print(count_digits(n))
#task8
def reverse_number(n, rev=0):
    if n == 0:
        return rev
    return reverse_number(n // 10, rev * 10 + n % 10)
n = int(input())
print(reverse_number(n))
#task9
def fibonacci(n):
    if n == 0:
        return 0
    if n == 1:
        return 1
    return fibonacci(n-1) + fibonacci(n-2)
n = int(input())
print(fibonacci(n))
