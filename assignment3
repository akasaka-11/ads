def two_sum(nums, target):
    seen = {}
    i = 0

    for num in nums:
        diff = target - num

        if diff in seen:
            return [seen[diff], i]

        seen[num] = i
        i += 1


# Example
print(two_sum([2, 7, 11, 15], 9))  
