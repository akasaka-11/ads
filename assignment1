def is_sorted(arr, n):
    if n == 1 or n == 0:
        return True
    if arr[n-2] > arr[n-1]:
        return False
    return is_sorted(arr, n-1)

print("Sorted" if is_sorted([1,2,4,7,9], 5) else "Not sorted") 
print("Sorted" if is_sorted([1,5,3,8], 4) else "Not sorted")
#task16
def binary_search(arr, low, high, target):
    if low > high:
        return -1
    mid = (low + high) // 2
    if arr[mid] == target:
        return mid
    elif arr[mid] > target:
        return binary_search(arr, low, mid-1, target)
    else:
        return binary_search(arr, mid+1, high, target)

arr = [1,3,5,7,9,11]
index = binary_search(arr, 0, len(arr)-1, 7)
print(f"Element found at index {index}" if index != -1 else "Element not found")  




  
