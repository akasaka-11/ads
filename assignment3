def is_isomorphic(s, t):
    if len(s) != len(t):
        return False

    map_st = {}
    map_ts = {}

    for i in range(len(s)):
        c1 = s[i]
        c2 = t[i]

        if (c1 in map_st and map_st[c1] != c2) or \
           (c2 in map_ts and map_ts[c2] != c1):
            return False

        map_st[c1] = c2
        map_ts[c2] = c1

    return True


# Example
print(is_isomorphic("egg", "add"))  
