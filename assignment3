def isSymmetric(root):
    def isMirror(a, b):
        if not a and not b:
            return True
        if not a or not b:
            return False
        return (
            a.value == b.value and
            isMirror(a.left, b.right) and
            isMirror(a.right, b.left)
        )

    return isMirror(root, root)


