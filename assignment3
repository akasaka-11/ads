def is_happy(n):
    seen = set()

    def next_num(x):
        total = 0
        while x > 0:
            x, d = divmod(x, 10)
            total += d * d
        return total

    while n != 1 and n not in seen:
        seen.add(n)
        n = next_num(n)

    return n == 1


# Example
print(is_happy(19))  
