#include <iostream>
using namespace std;
bool linearSearch(int arr[], int n, int target){
    if(n==0){
    return false;
    }
    if(arr[n-1]==target){
    return true;
    }
    return linearSearch(arr,n-1,target);
}
int main(){
    int n, target;
    cin >> n;
    int arr[n];
    for(int i=0;i<n;i++) cin >> arr[i];
    cin >> target;
    if(linearSearch(arr,n,target))
        cout << "Found";
    else
        cout << "Not found";
}
