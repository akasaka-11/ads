def sort_colors(nums):
    l, m, r = 0, 0, len(nums) - 1

    while m <= r:
        if nums[m] == 0:
            nums[l], nums[m] = nums[m], nums[l]
            l += 1
            m += 1
        elif nums[m] == 1:
            m += 1
        else:
            nums[m], nums[r] = nums[r], nums[m]
            r -= 1


# Example
nums = [2, 0, 2, 1, 1, 0]
sort_colors(nums)
print(nums)  # [0,0,1,1,2,2]

