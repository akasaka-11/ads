#include <iostream>
using namespace std;

int cntOcc(int arr[], int n, int target){
    if(n==0) return 0;
    if(arr[n-1]==target)
        return 1 + cntOcc(arr,n-1,target);
    return cntOcc(arr,n-1,target);
}
int main(){
    int n, target;
    cin >> n;
    int arr[n];
    for(int i=0;i<n;i++) cin >> arr[i];
    cin >> target;
    cout << cntOcc(arr,n,target);
}
